; the switch between the optimized code and the simple code it
; replaced, kept runnable beside it (Mini_opti.mli;
; docs/plans/plan_performance.md). One module and no dependency, so that
; languages/ and src/layout, which link no graphics library, can read
; it as src/ does. Not named Opti: tiny_libs.graphics_core has an
; unwrapped module of that name (the rasterizer's switch), linked with
; the Playground, and two would not link.
(library
 (name mini_opti)
 (wrapped false)
 (libraries unix)) ; Stopwatch reads the clock

; a value a domain (Per_domain.mli): Domain.DLS under OCaml 5, one
; value under 4.14, which has one domain
(rule
 (targets Per_domain.ml)
 (enabled_if (< %{ocaml_version} 5.0))
 (action (copy domain/threads.ml.in %{targets})))

(rule
 (targets Per_domain.ml)
 (enabled_if (>= %{ocaml_version} 5.0))
 (action (copy domain/domains.ml.in %{targets})))
