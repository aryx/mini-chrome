(* See Per_domain.mli: OCaml 5's, a value a domain (Domain.DLS) *)

let parallel = true

let make (init : unit -> 'a) : unit -> 'a =
  let key = Domain.DLS.new_key init in
  fun () -> Domain.DLS.get key

let main () : bool = Domain.is_main_domain ()
