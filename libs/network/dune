; the browser's networking, from elm-playground's libs/networking
; (its tiny_libs.networking_* libraries), the part a browser needs:
; protocols/ (Url, Urlencoded, Http: RFC 3986, forms' queries, HTTP/1.1
; messages; Websocket: RFC 6455's handshake and frames), tls/ (Asn1, Pem, X509, Tls13: a TLS 1.3 client, pure, bytes
; in and bytes out) and unix/ (Tcp, Worker, Tls_client, Http_client,
; Http_request: the sockets, the GET, and the same GET as a non-blocking
; machine stepped each frame; Websocket_client: a WebSocket's
; connection, stepped too). Its own copy, to grow (cookies,
; keep-alive); the cryptography stays tiny_libs.crypto, gzip and
; Zstandard tiny_libs.compression; Brotli, the web's own, is
; libs/compression.
;
; Wrapped, as Network: the Playground links tiny_libs' networking (its
; Http and Multiplayer APIs, and the native platforms' Http.get), whose
; unwrapped modules have the same names -- two modules Url in one program
; would not link. Never written, though: the libraries using it say
; (flags (:standard -open Network)), and their code Url.parse,
; Http_request.start, ours rather than the Playground's.
(include_subdirs unqualified)

(library
 (name network)
 (wrapped true)
 (libraries
   unix
   threads.posix ; Worker's pool
   mini_opti ; Keep_alive: opti=off closes each connection
   caps ; Cap.network, which every function opening a socket takes
   logs ; -v: the roots' file read
   tiny_libs.crypto ; the hashes, ciphers and signatures of TLS
   tiny_libs.compression ; Gzip, Zstd: a body with Content-Encoding: gzip, zstd
   mini_compression ; Brotli and its dictionary: Content-Encoding: br
   tiny_libs.core)) ; Base64 (PEM), Civil and Clock (certificates' dates)

; a worker of the pool is a thread under OCaml 4.14, a domain under
; OCaml 5 (Worker_spawn.mli): the same program, built by both
(rule
 (targets Worker_spawn.ml)
 (enabled_if (< %{ocaml_version} 5.0))
 (action (copy spawn/threads.ml.in %{targets})))

(rule
 (targets Worker_spawn.ml)
 (enabled_if (>= %{ocaml_version} 5.0))
 (action (copy spawn/domains.ml.in %{targets})))
