(* See Worker_spawn.mli: OCaml 5's way, a domain. The file is
 * libs/network/spawn/domains.ml.in, copied by dune. *)

let parallel = true

(* a domain a core at most, one left to the window: more would make
 * each minor collection, which stops them all, wait for a domain that
 * has no core to run on *)
let workers (asked : int) : int = max 1 (min asked (Domain.recommended_domain_count () - 1))
let spawn (f : unit -> unit) : unit = ignore (Domain.spawn f : unit Domain.t)
