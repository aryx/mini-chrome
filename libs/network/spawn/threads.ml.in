(* See Worker_spawn.mli: OCaml 4.14's way, a thread. The file is
 * libs/network/spawn/threads.ml.in, copied by dune. *)

let parallel = false
let workers (asked : int) : int = asked
let spawn (f : unit -> unit) : unit = ignore (Thread.create f () : Thread.t)
