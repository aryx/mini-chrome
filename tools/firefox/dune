 (name MiniFirefox)
 (public_name mini-firefox)
 (flags (:standard -open Network)) ; ours (libs/network/dune)
 (libraries
   caps logs tiny_libs.core network
   lang_html lang_css javascript browser_layout
   browser_url browser_display browser_www browser_webapi browser_about browser_chrome
   mosaic_engine
   elm_playground mini_platform))
