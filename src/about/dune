; the about: pages, the browser's built-in site (Site.mli): its
; files embedded as strings, data/about/home.html becoming
; Site_pages.home at build time, so the browser has something to show
; with no network; and the video site of our own, about:tube (Tube,
; Tube_clips), its three clips made elsewhere in data/tube/.
;
; The files are data, kept in data/ at the top; copied here at build
; time (copy_files), so that the rules below name them plainly.
(copy_files ../../data/about/*)
(copy_files ../../data/tube/*)

(library
 (name browser_about)
 (wrapped false)
 (modules Site Site_pages Site_pictures Tube Tube_clips Tube_files)
 (libraries
   tiny_libs.graphics_core tiny_libs.graphics_2d ; the clip's frames, drawn
   tiny_libs.graphics_rgba tiny_libs.graphics_y4m tiny_libs.graphics_fli
   tiny_libs.graphics_avi tiny_libs.graphics_mpeg1
   tiny_libs.audio tiny_libs.audio_signal ; the clip's sound
   tiny_libs.compression))

(rule
 (targets Site_pages.ml)
 (deps home.html history.html form.html netscape.html css.html
       firefox.html counter.html todo.html timer.html tictactoe.html
       chrome.html chrome.css chrome-colours.css threads.html threads.js)
 (action
  (with-stdout-to
   %{targets}
   (progn
    (echo "(* generated from data/about/*.html by src/about/dune *)\n")
    (echo "let home = {|")
    (cat home.html)
    (echo "|}\n")
    (echo "let history = {|")
    (cat history.html)
    (echo "|}\n")
    (echo "let form = {|")
    (cat form.html)
    (echo "|}\n")
    (echo "let netscape = {|")
    (cat netscape.html)
    (echo "|}\n")
    (echo "let css = {|")
    (cat css.html)
    (echo "|}\n")
    (echo "let firefox = {|")
    (cat firefox.html)
    (echo "|}\n")
    (echo "let counter = {|")
    (cat counter.html)
    (echo "|}\n")
    (echo "let todo = {|")
    (cat todo.html)
    (echo "|}\n")
    (echo "let timer = {|")
    (cat timer.html)
    (echo "|}\n")
    (echo "let tictactoe = {|")
    (cat tictactoe.html)
    (echo "|}\n")
    (echo "let chrome = {|")
    (cat chrome.html)
    (echo "|}\n")
    (echo "let chrome_css = {|")
    (cat chrome.css)
    (echo "|}\n")
    (echo "let chrome_colours_css = {|")
    (cat chrome-colours.css)
    (echo "|}\n")
    (echo "let threads = {|")
    (cat threads.html)
    (echo "|}\n")
    (echo "let threads_js = {|")
    (cat threads.js)
    (echo "|}\n")))))

; bytes that are not text, embedded escaped
; (scripts/files_to_string_ml.ml): picture.gif becomes
; Site_pictures.picture_gif, the same picture in the formats the
; browser decodes (WebP twice: lossy and lossless); and about:tube's two files made elsewhere (the .mpg by
; ffmpeg, the .mp3 by LAME), Tube_files
(rule
 (targets Site_pictures.ml)
 (deps picture.gif picture.png picture.jpg picture.webp picture-lossless.webp
       %{project_root}/scripts/files_to_string_ml.ml)
 (action
  (with-stdout-to
   %{targets}
   (run ocaml %{project_root}/scripts/files_to_string_ml.ml picture.gif picture.png picture.jpg
        picture.webp picture-lossless.webp))))

(rule
 (targets Tube_files.ml)
 (deps ball_and_square.mpg ball_and_square.webm stereo.mp3 %{project_root}/scripts/files_to_string_ml.ml)
 (action
  (with-stdout-to
   %{targets}
   (run ocaml %{project_root}/scripts/files_to_string_ml.ml ball_and_square.mpg ball_and_square.webm stereo.mp3))))
