; JavaScript in a browser: what a page's scripts see and do,
; over the language (languages/javascript, which knows nothing of
; pages). Script_dom is the page's mutable copy; Script_host an
; element's host object, Script_element its members since the first
; DOM, Script_events an event of a script's own, Script_document
; document, Script_window window and its globals, Script_fetch and
; XMLHttpRequest a script asking the network, Cors who may read the
; answer, LocalStorage a page's store, Event_loop the timers and the
; order things run in, WebSocket a socket
; that stays, Script_url
; URLSearchParams; their types in
; Script_types; Browser_script the tasks (the scripts run, an event
; dispatched, the timers) and what the browser asks of them.
(library
 (name browser_dom)
 (wrapped false)
 (modules_without_implementation script_types) ; types alone
 (flags (:standard -open Network)) ; ours, not the Playground's (libs/network/dune)
 (libraries
   lang_html lang_css javascript
   browser_url
   network)) ; Urlencoded, a URL's query

; the small web APIs written in JavaScript (data/prelude/web.js: data,
; kept in data/ at the top and copied here at build time), embedded
; as a string: Script_prelude
(copy_files ../../data/prelude/web.js)

(rule
 (targets Script_prelude.ml)
 (deps web.js)
 (action
  (with-stdout-to
   %{targets}
   (progn
    (echo "(* generated from data/prelude/web.js by src/dom/dune *)\n")
    (echo "let text = {prelude|")
    (cat web.js)
    (echo "|prelude}\n")))))
