; claude: the same program (../MiniChrome.ml, copied at build time, not
; a second source) on the Playground's software platform: every pixel
; computed by its own rasterizer, SDL only for the window -- no Cairo.
; See ../dune.
(copy_files# ../MiniChrome.ml)

(executable
 (name MiniChrome)
 (public_name mini-chrome-software)
 (flags (:standard -open Network)) ; as ../dune's
 (libraries
   caps logs
   mini_opti ; opti=off
   tiny_libs.core network mini_gui
   lang_html lang_css browser_layout
   browser_url browser_display browser_www browser_viewers browser_about browser_chrome
   browser_window ; the program: its model, update and view
   elm_playground
   elm_playground_software)) ; implem of virtual elm_playground: SDL and our own rasterizer
