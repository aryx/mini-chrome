# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0"
synopsis: "A web browser from scratch in OCaml, after Google Chrome"
description: """
A small web browser written from scratch in OCaml: HTML, CSS (the
  cascade, the box model, flexbox), a JavaScript engine, SVG, pictures,
  <video> and <audio>, tabs, an omnibox and developer tools. It started
  as elm-playground's TinyChrome.
"""
maintainer: ["Yoann Padioleau <yoann.padioleau@gmail.com>"]
authors: ["Yoann Padioleau <yoann.padioleau@gmail.com>"]
license: "LGPL-2.1-only"
homepage: "https://github.com/aryx/mini-chrome"
bug-reports: "https://github.com/aryx/mini-chrome/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "4.14.0"}
  "caps" {>= "0.1.0"}
  "tiny_libs" {>= "0.3.1"}
  "elm_playground" {>= "0.3.1"}
  "elm_playground_software" {>= "0.3.1"}
  "testo" {with-test}
  "alcotest" {with-test}
  "conf-openssl" {with-test}
  "odoc" {with-doc}
]
depopts: ["elm_playground_native"]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/aryx/mini-chrome.git"
