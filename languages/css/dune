; claude: what a page's elements look like:
; Looks, Mosaic's fixed table computed down the tree; and the page's
; style sheets cascaded on top of it: Css_syntax (the text read:
; tokens, blocks, rules), Selectors (which elements a rule is for), Css
; (the cascade); Css_values (lengths, colours, calc(), var()), Cascade
; (@media, origins, the rule index), Computed (a style per element, over
; ua.css: Ua_sheet). Pure OCaml, no shapes: a look is numbers and
; flags, the browser draws it.
(library
 (name lang_css)
 (wrapped false)
 (libraries lang_html) ; Dom
)

; claude: the browser's own style sheet, ua.css, embedded as a string
(rule
 (targets Ua_sheet.ml)
 (deps ua.css)
 (action
  (with-stdout-to
   %{targets}
   (progn
    (echo "(* generated from ua.css by languages/css/dune *)\n")
    (echo "let text = {|")
    (cat ua.css)
    (echo "|}\n")))))
