; a small JavaScript: Js_lexer (the text to tokens), Js_ast (the
; tree), Js_parse (statements by recursive descent, expressions by Pratt
; -- and why not yacc), Js_value (values, objects, the conversions),
; Js_eval (the tree walked: closures, this, the errors), Js_scope
; (where names live, the simple way and the fast one), Js_frame (a
; call's), Js_quicken (the tree's copy the fast way runs), Js_compile
; (a function's body made closures, apart from Js_eval),
; Js_builtins (console, Math, strings' and arrays' methods), Js_promise
; (promises and their jobs, async and await) over Js_coroutine. The
; language only: what a script can touch outside itself is its host's,
; a record of functions, so the browser gives it a page
; (src/webapi's Browser_script), a terminal gives it files and timers
; (tools/node: mini-node), and a test gives it nothing.
;
; Pure OCaml, no Playground; the modules are Js_ because the libraries
; are unwrapped and js_of_ocaml's own module is Js.
(library
 (name javascript)
 (wrapped false)
 ; every module linked, used by name or not: Js_compile tells Js_eval
 ; of itself when the program starts, and nobody else names it
 (library_flags (-linkall))
 (libraries
  mini_opti ; the simple scopes or the fast ones (Js_scope)
  tiny_libs.random ; Lehmer, Math.random's seeded numbers
  threads.posix ; Js_coroutine: an async function stopped at an await
 )
)

; the library's later additions, written in JavaScript
; (data/prelude/library.js: data, kept in data/ at the top and copied
; here at build time), embedded as a string: Js_prelude
(copy_files ../../data/prelude/library.js)

(rule
 (targets Js_prelude.ml)
 (deps library.js)
 (action
  (with-stdout-to
   %{targets}
   (progn
    (echo "(* generated from data/prelude/library.js by languages/javascript/dune *)\n")
    (echo "let text = {prelude|")
    (cat library.js)
    (echo "|prelude}\n")))))

; its modules are in subfolders, one library still
(include_subdirs unqualified)
