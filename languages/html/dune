; HTML read: the bytes of a page to text (Charset), the
; characters it names (Entities), its tokens (Html_lexer), its tree
; (Dtd, Html_tree: a Dom, libs/dom's), and the tree as text
; (Line_mode). Pure OCaml, no shapes, natively and in a browser.
(library
 (name lang_html)
 (wrapped false)
 (libraries mini_dom)) ; Dom: what a page is read into

; its modules are in subfolders, one library still
(include_subdirs unqualified)
