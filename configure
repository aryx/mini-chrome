#!/bin/sh
set -eu # to debug this script add '-x'

###############################################################################
# Prelude
###############################################################################
# The goal of this script is to automate the configuration and installation
# of packages that are needed to then compile mini-chrome itself.
# coupling: adapted from ~/github/ocaml-elm-playground/configure
#
# Usage: ./configure [--software]
#
# mini-chrome is drawn by the Playground, on one of its two native
# platforms (src/main/dune): Cairo's (elm_playground_native, the program
# mini-chrome) or its own rasterizer (elm_playground_software,
# mini-chrome-software), SDL for the window either way. Both are built
# by default; --software leaves Cairo out altogether: no check for it,
# no elm_playground_native, and only mini-chrome-software is built --
# as happens anyway, with a warning, when Cairo is not found.

software=0
for arg in "$@"; do
    case "$arg" in
    --software) software=1 ;;
    *) echo "usage: ./configure [--software]" >&2; exit 1 ;;
    esac
done

###############################################################################
# Helper functions
###############################################################################

ok()   { echo "  [OK]   $1"; }
warn() { echo "  [WARN] $1"; }
err()  { echo "  [ERR]  $1" >&2; }

errors=0

need_command() {
    if command -v "$1" >/dev/null 2>&1; then
        ok "$1 ($(command -v "$1"))"
    else
        err "$1 not found in PATH"
        errors=$((errors + 1))
    fi
}

check_c_lib() {
    name="$1"
    pkg="$2"
    header="$3"
    what="$4"

    if command -v pkg-config >/dev/null 2>&1 \
       && pkg-config --exists "$pkg" 2>/dev/null; then
        ok "$name (pkg-config: $pkg)"
        return 0
    fi

    search_dirs="/usr/include /usr/local/include"
    if command -v brew >/dev/null 2>&1; then
        search_dirs="$search_dirs $(brew --prefix 2>/dev/null)/include"
    fi

    for dir in $search_dirs; do
        if [ -f "$dir/$header" ]; then
            ok "$name (header: $dir/$header)"
            return 0
        fi
    done

    warn "$name not found (pkg-config module '$pkg', header '$header'); $what won't build without it"
    return 1
}

# On macOS, extend PKG_CONFIG_PATH for Homebrew
if command -v brew >/dev/null 2>&1; then
    _brew_prefix="$(brew --prefix 2>/dev/null || true)"
    if [ -n "$_brew_prefix" ]; then
        PKG_CONFIG_PATH="${_brew_prefix}/lib/pkgconfig:${PKG_CONFIG_PATH:-}"
        export PKG_CONFIG_PATH
    fi
fi

###############################################################################
# Check required tools
###############################################################################

echo "Checking required tools..."

need_command ocaml
need_command opam
need_command make
need_command git

if [ "$errors" -ne 0 ]; then
    echo "$errors error(s) found. Please fix the issues above and re-run ./configure."
    exit 1
fi

echo ""

###############################################################################
# Check C libraries needed by the Playground's native platforms
###############################################################################
# coupling: elm_playground_software.opam (tsdl), elm_playground_native.opam
# (tsdl, cairo2)

echo "Checking C libraries for the Playground's native platforms..."

check_c_lib "SDL2"  "sdl2"  "SDL2/SDL.h" "mini-chrome" || true
if [ "$software" -eq 1 ]; then
    ok "cairo (not needed: --software)"
elif ! check_c_lib "cairo" "cairo" "cairo.h" "mini-chrome (Cairo's; mini-chrome-software will)"; then
    # no Cairo, no Cairo platform to install: as --software
    warn "going on as with --software: only mini-chrome-software will be built"
    software=1
fi

echo ""

###############################################################################
# elm-playground's packages
###############################################################################
# mini-chrome stands on elm-playground's packages (tiny_libs, the
# Playground and its native platforms), 0.3.1 or later. Until 0.3.1 is
# on opam, they are pinned from the tag: opam builds them from
# elm-playground's sources. Not when opam already knows them (from
# opam-repository, or a 'make install' in an elm-playground checkout,
# the way to work on both at once: see README.md).
# coupling: the (depends ...) and (depopts ...) of dune-project

ELM_PLAYGROUND=git+https://github.com/aryx/ocaml-elm-playground#0.3.1
# what mini-chrome uses (its own languages/ replace tiny_languages')
PACKAGES="tiny_libs elm_playground elm_playground_software"
[ "$software" -eq 1 ] || PACKAGES="$PACKAGES elm_playground_native"
# and what opam needs to install those, when they are pinned: the
# packages elm_playground's opam file depends on (its own kits use
# tiny_languages and tiny_appkits), which mini-chrome never links
PINNED_TOO="tiny_languages tiny_appkits"

echo "Checking elm-playground's packages..."
outside_opam=0
pinned=0
for p in $PACKAGES; do
    if opam show "$p" --field=all-versions 2>/dev/null | grep -q '0\.3\.0'; then
        ok "$p (known to opam)"
    elif ocamlfind query "$p" >/dev/null 2>&1; then
        ok "$p (installed outside opam: $(ocamlfind query "$p"))"
        outside_opam=1
    else
        warn "$p not on opam yet: pinned from $ELM_PLAYGROUND"
        opam pin add --no-action -y "$p" "$ELM_PLAYGROUND"
        pinned=1
    fi
done
if [ "$pinned" -eq 1 ]; then
    for p in $PINNED_TOO; do
        opam show "$p" --field=all-versions 2>/dev/null | grep -q '0\.3\.0' \
          || opam pin add --no-action -y "$p" "$ELM_PLAYGROUND"
    done
fi

echo ""

###############################################################################
# Install opam dependencies
###############################################################################

echo "Installing opam dependencies..."
if [ "$outside_opam" -eq 1 ]; then
    # elm-playground's packages installed by its 'make install' (dune
    # install) are unknown to opam, which then cannot solve
    # mini-chrome.opam: the other dependencies are installed by name
    # (theirs came with them)
    # coupling: the (depends ...) of dune-project
    opam install --confirm-level=unsafe-yes -y caps testo alcotest conf-openssl
else
    # --with-test for what 'make test' needs (testo, alcotest)
    opam install --confirm-level=unsafe-yes --deps-only --with-test -y ./mini-chrome.opam
    # the Cairo platform, an optional dependency (depopts), which
    # --deps-only leaves out
    if [ "$software" -eq 0 ]; then
        opam install --confirm-level=unsafe-yes -y elm_playground_native
    fi
fi

echo ""
echo "Everything looks fine. You can now run:"
echo ""
echo "   $ make"
echo "   $ make test"
