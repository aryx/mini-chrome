; unit tests for the JavaScript engine, run by 'make test'
; (dune runtest): the worked examples of the .mlis; and JSON, its
; literals read by its lexer (languages/json)
(test
 (name Test)
 (libraries alcotest testo mini_opti javascript lang_json) ; Json, over Js_lexer
)

; the same tests on the engine's simple code paths (Mini_opti: scopes
; as tables, Js_scope; the operators and an array's items the long
; way): what the optimized paths give, the simple ones must
(rule
 (alias runtest)
 (action
  (setenv MINI_OPTI off (run %{exe:Test.exe}))))

; and a third time with the functions' bodies walked by the evaluator,
; not compiled (Js_compile): the first run is the compiled one
(rule
 (alias runtest)
 (action
  (setenv MINI_OPTI walk (run %{exe:Test.exe}))))
